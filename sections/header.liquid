<script>
  (function() {
    // Dropdowns Desktop (solo si existen elementos con data-dropdown)
    const navItems = document.querySelectorAll('.nav-item[data-dropdown]');
    
    if (navItems.length > 0) {
      navItems.forEach(item => {
        const link = item.querySelector('.nav-link');
        
        link.addEventListener('click', (e) => {
          e.preventDefault();
          
          // Cerrar otros dropdowns
          navItems.forEach(otherItem => {
            if (otherItem !== item) {
              otherItem.classList.remove('active');
              otherItem.querySelector('.nav-link').setAttribute('aria-expanded', 'false');
            }
          });
          
          // Toggle actual
          item.classList.toggle('active');
          const isExpanded = item.classList.contains('active');
          link.setAttribute('aria-expanded', isExpanded);
        });
      });

      // Cerrar dropdowns al hacer click fuera
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.nav-item')) {
          navItems.forEach(item => {
            item.classList.remove('active');
            item.querySelector('.nav-link').setAttribute('aria-expanded', 'false');
          });
        }
      });
    }

    // Mobile Menu
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    const mobileToggleLeft = document.getElementById('mobile-menu-toggle-left');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileOverlay = document.getElementById('mobile-overlay');
    const closeMenu = document.getElementById('close-menu');

    function openMenu() {
      mobileMenu.classList.add('active');
      mobileOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeMenuFn() {
      mobileMenu.classList.remove('active');
      mobileOverlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    mobileToggle.addEventListener('click', openMenu);
    if (mobileToggleLeft) mobileToggleLeft.addEventListener('click', openMenu);
    closeMenu.addEventListener('click', closeMenuFn);
    mobileOverlay.addEventListener('click', closeMenuFn);

    // Cerrar con tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenuFn();
        setMegaMenuState(false);
        if (navItems.length > 0) {
          navItems.forEach(item => {
            item.classList.remove('active');
            item.querySelector('.nav-link').setAttribute('aria-expanded', 'false');
          });
        }
      }
    });

    // Mega menú "Todas las categorías" (desktop)
    const categoriesToggle = document.getElementById('categories-toggle');
    const megaItem = document.getElementById('all-categories-mega-item');
    let megaCloseTimer = null;

    function setMegaMenuState(isOpen) {
      if (!megaItem || !categoriesToggle) return;
      megaItem.classList.toggle('active', isOpen);
      categoriesToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }

    if (categoriesToggle && megaItem) {
      categoriesToggle.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = megaItem.classList.contains('active');
        setMegaMenuState(!isOpen);
      });

      megaItem.addEventListener('mouseenter', () => {
        if (window.innerWidth <= 768) return;
        clearTimeout(megaCloseTimer);
        setMegaMenuState(true);
      });

      megaItem.addEventListener('mouseleave', () => {
        if (window.innerWidth <= 768) return;
        megaCloseTimer = setTimeout(() => setMegaMenuState(false), 120);
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('#all-categories-mega-item')) {
          setMegaMenuState(false);
        }
      });
    }

    // ============================================
    // WISHLIST / FAVORITOS - CONTADOR EN TIEMPO REAL
    // ============================================
    
    // Limpiar datos antiguos del localStorage
    (function cleanupOldWishlistData() {
      try {
        const wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
        const validItems = wishlist.filter(item => typeof item === 'string' && !/^\d+$/.test(item));
        if (validItems.length !== wishlist.length) {
          localStorage.setItem('wishlist', JSON.stringify(validItems));
        }
      } catch (e) {}
    })();

    // Función para obtener wishlist del localStorage
    function getWishlist() {
      try {
        const wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
        // Filtrar solo handles válidos (strings, no IDs numéricos antiguos)
        return wishlist.filter(item => typeof item === 'string' && !/^\d+$/.test(item));
      } catch (e) {
        return [];
      }
    }
    
    // Función para actualizar contador de favoritos en el header
    function updateHeaderWishlistCount(count) {
      const counters = document.querySelectorAll('[data-header-wishlist-count]');
      
      counters.forEach(counter => {
        counter.textContent = count;
        
        if (count > 0) {
          counter.style.display = 'flex';
          counter.style.visibility = 'visible';
          counter.style.opacity = '1';
        } else {
          counter.style.display = 'none';
        }
        
        // Animación
        counter.style.transform = 'scale(1.4)';
        setTimeout(() => {
          counter.style.transform = 'scale(1)';
        }, 200);
      });
    }
    
    // Actualizar contador al cargar la página
    const initialWishlist = getWishlist();
    updateHeaderWishlistCount(initialWishlist.length);
    
    // Escuchar eventos de wishlist desde cualquier página
    window.addEventListener('wishlist:updated', function(e) {
      if (e.detail && typeof e.detail.count !== 'undefined') {
        updateHeaderWishlistCount(e.detail.count);
      } else {
        // Si no viene el count, leer del localStorage
        updateHeaderWishlistCount(getWishlist().length);
      }
    });
    
    // También escuchar el evento storage (si se actualiza en otra pestaña)
    window.addEventListener('storage', function(e) {
      if (e.key === 'wishlist') {
        const wishlist = getWishlist();
        updateHeaderWishlistCount(wishlist.length);
      }
    });
    
    // ACTUALIZAR CONTADOR DEL CARRITO EN TIEMPO REAL
    function updateHeaderCartCount(count) {
      const counters = document.querySelectorAll('.cart-count, [data-cart-count]');
      
      counters.forEach(counter => {
        counter.textContent = count;
        
        if (count > 0) {
          counter.style.display = 'flex';
          counter.style.visibility = 'visible';
          counter.style.opacity = '1';
        } else {
          counter.style.display = 'none';
        }
        
        // Animación
        counter.style.transform = 'scale(1.4)';
        setTimeout(() => {
          counter.style.transform = 'scale(1)';
        }, 200);
      });
    }
    
    // Escuchar evento personalizado del PDP
    window.addEventListener('cart:updated', function(e) {
      if (e.detail && typeof e.detail.itemCount !== 'undefined') {
        updateHeaderCartCount(e.detail.itemCount);
      }
    });
    
    // También escuchar cambios en el carrito desde otras páginas
    document.addEventListener('click', function(e) {
      // Si se hizo clic en un botón de agregar al carrito
      if (e.target.closest('[data-ajax-cart] button[type="submit"], .add-to-cart, [data-add-to-cart]')) {
        // Esperar un momento y actualizar el contador
        setTimeout(() => {
          fetch('/cart.js?v=' + Date.now())
            .then(r => r.json())
            .then(cart => updateHeaderCartCount(cart.item_count))
            .catch(err => console.error('Error:', err));
        }, 500);
      }
    });

    // ============================================
    // BÚSQUEDA CON SUGERENCIAS EN TIEMPO REAL
    // ============================================
    const searchInput = document.getElementById('search-input');
    const searchSuggestions = document.getElementById('search-suggestions');
    const suggestionsContent = document.querySelector('[data-suggestions-content]');
    
    if (searchInput && searchSuggestions) {
      let searchTimeout;
      let highlightedIndex = -1;
      
      // Al cargar la página, asegurarse de que las sugerencias estén cerradas
      searchSuggestions.classList.remove('active');
      searchSuggestions.style.cssText = 'display: none !important; opacity: 0; visibility: hidden;';
      
      // Función para buscar sugerencias
      async function fetchSuggestions(query) {
        if (!query || query.length < 2) {
          searchSuggestions.classList.remove('active');
          return;
        }
        
        try {
          suggestionsContent.innerHTML = '<div class="search-suggestions-loading"></div>';
          searchSuggestions.classList.add('active');
          
          // Usar la API de búsqueda de Shopify
          const response = await fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product,collection,article,page&resources[limit]=8`);
          const data = await response.json();
          
          if (!data.resources || !data.resources.results) {
            searchSuggestions.classList.remove('active');
            return;
          }
          
          const results = data.resources.results;
          let html = '';
          let totalResults = 0;
          
          // Productos
          if (results.products && results.products.length > 0) {
            totalResults += results.products.length;
            results.products.forEach(product => {
              const image = product.image ? product.image.replace('\\/', '/') : '';
              html += `
                <a href="${product.url}" class="search-suggestion-item" data-suggestion>
                  ${image ? `<img src="${image}" alt="" class="search-suggestion-image">` : '<div class="search-suggestion-image" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>'}
                  <div class="search-suggestion-info">
                    <p class="search-suggestion-title">${product.title}</p>
                    <p class="search-suggestion-price">${product.price}</p>
                  </div>
                  <span class="search-suggestion-type">Producto</span>
                </a>
              `;
            });
          }
          
          // Colecciones
          if (results.collections && results.collections.length > 0) {
            totalResults += results.collections.length;
            results.collections.forEach(collection => {
              html += `
                <a href="${collection.url}" class="search-suggestion-item" data-suggestion>
                  <div class="search-suggestion-image" style="background: linear-gradient(135deg, #f5f5f5 0%, #e5e5e5 100%);"></div>
                  <div class="search-suggestion-info">
                    <p class="search-suggestion-title">${collection.title}</p>
                  </div>
                  <span class="search-suggestion-type">Colección</span>
                </a>
              `;
            });
          }
          
          // Artículos
          if (results.articles && results.articles.length > 0) {
            totalResults += results.articles.length;
            results.articles.forEach(article => {
              html += `
                <a href="${article.url}" class="search-suggestion-item" data-suggestion>
                  <div class="search-suggestion-image" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
                  <div class="search-suggestion-info">
                    <p class="search-suggestion-title">${article.title}</p>
                  </div>
                  <span class="search-suggestion-type">Artículo</span>
                </a>
              `;
            });
          }
          
          // Páginas
          if (results.pages && results.pages.length > 0) {
            totalResults += results.pages.length;
            results.pages.forEach(page => {
              html += `
                <a href="${page.url}" class="search-suggestion-item" data-suggestion>
                  <div class="search-suggestion-image" style="background: #f5f5f5; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    </svg>
                  </div>
                  <div class="search-suggestion-info">
                    <p class="search-suggestion-title">${page.title}</p>
                  </div>
                  <span class="search-suggestion-type">Página</span>
                </a>
              `;
            });
          }
          
          if (totalResults === 0) {
            html = '<div class="search-suggestions-empty">No se encontraron resultados</div>';
          } else {
            // Agregar footer con "Ver todos los resultados"
            html += `
              <div class="search-suggestions-footer">
                <a href="/search?q=${encodeURIComponent(query)}" class="search-suggestions-view-all">
                  Ver todos los resultados (${totalResults})
                </a>
              </div>
            `;
          }
          
          suggestionsContent.innerHTML = html;
          highlightedIndex = -1;
          
        } catch (error) {
          console.error('Error fetching suggestions:', error);
          searchSuggestions.classList.remove('active');
        }
      }
      
      // Función para cerrar sugerencias definitivamente
      function closeSuggestions() {
        searchSuggestions.classList.remove('active');
        searchSuggestions.style.cssText = 'display: none !important; opacity: 0; visibility: hidden;';
        highlightedIndex = -1;
        searchInput.blur();
      }
      
      // Cerrar sugerencias al enviar el formulario
      searchInput.closest('form').addEventListener('submit', function(e) {
        closeSuggestions();
      });
      
      // También cerrar cuando el input pierde el foco
      searchInput.addEventListener('blur', function() {
        setTimeout(() => {
          if (!searchSuggestions.matches(':hover')) {
            closeSuggestions();
          }
        }, 200);
      });
      
      // Evento input con debounce
      searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        const query = this.value.trim();
        
        if (query.length < 2) {
          searchSuggestions.classList.remove('active');
          return;
        }
        
        searchTimeout = setTimeout(() => {
          fetchSuggestions(query);
        }, 300); // Esperar 300ms después de que el usuario deje de escribir
      });
      
      // Navegación con teclado
      searchInput.addEventListener('keydown', function(e) {
        const items = searchSuggestions.querySelectorAll('[data-suggestion]');
        
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          highlightedIndex = Math.min(highlightedIndex + 1, items.length - 1);
          updateHighlight(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          highlightedIndex = Math.max(highlightedIndex - 1, -1);
          updateHighlight(items);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (highlightedIndex >= 0 && items[highlightedIndex]) {
            items[highlightedIndex].click();
          } else {
            // Si no hay item seleccionado, cerrar sugerencias y enviar el formulario
            searchSuggestions.classList.remove('active');
            searchSuggestions.style.display = 'none';
            highlightedIndex = -1;
            searchInput.blur();
            
            // Enviar el formulario después de un pequeño delay para cerrar las sugerencias
            setTimeout(() => {
              searchInput.closest('form').submit();
            }, 50);
          }
        } else if (e.key === 'Escape') {
          searchSuggestions.classList.remove('active');
          highlightedIndex = -1;
        }
      });
      
      function updateHighlight(items) {
        items.forEach((item, index) => {
          if (index === highlightedIndex) {
            item.classList.add('highlighted');
            item.scrollIntoView({ block: 'nearest' });
          } else {
            item.classList.remove('highlighted');
          }
        });
      }
      
      // Cerrar sugerencias al hacer clic fuera
      document.addEventListener('click', function(e) {
        if (!e.target.closest('#search-form')) {
          closeSuggestions();
        }
      });
      
      // Cerrar sugerencias antes de salir de la página
      window.addEventListener('beforeunload', function() {
        closeSuggestions();
      });
      
      // Prevenir cierre al hacer clic dentro de las sugerencias
      searchSuggestions.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }
  })();
</script>

