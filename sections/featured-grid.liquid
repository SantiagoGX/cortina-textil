{% comment %}
  Featured Grid Section
  Estructura: Section (100vw) > Container (1512px) > Grid de tarjetas
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .featured-grid-section {
    position: relative;
    width: 100%;
    padding: 64px 0;
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
  }

  /* CONTENEDOR PADRE - 1512px, alto automático */
  .featured-grid-container {
    position: relative;
    width: 100%;
    max-width: 1512px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Grid layout */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 24px;
    min-height: min(520px, 70vh);
  }

  /* Tarjetas */
  .featured-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
    text-decoration: none;
    min-height: 280px;
  }

  /* Tarjeta grande (izquierda) */
  .featured-card.large {
    grid-row: 1 / 3;
    grid-column: 1 / 2;
  }

  /* Tarjetas pequeñas (derecha) */
  .featured-card.small-top {
    grid-row: 1 / 2;
    grid-column: 2 / 3;
  }

  .featured-card.small-bottom {
    grid-row: 2 / 3;
    grid-column: 2 / 3;
  }

  /* Imagen de fondo */
  .featured-card-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  /* Overlay */
  .featured-card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.1) 100%);
    z-index: 2;
  }

  /* Contenido */
  .featured-card-content {
    position: relative;
    z-index: 3;
    color: #ffffff;
  }

  .featured-card-title {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 12px;
    line-height: 1.3;
    color: #ffffff;
  }

  .featured-card-subtitle {
    font-size: 16px;
    font-weight: 400;
    opacity: 0.9;
    margin-bottom: 24px;
    line-height: 1.5;
    color: #ffffff;
  }

  /* Botón */
  .featured-card-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid #ffffff;
    padding-bottom: 4px;
    transition: all 0.3s ease;
  }

  .featured-card-button:hover {
    gap: 12px;
    opacity: 0.8;
  }

  .featured-card-button svg {
    width: 16px;
    height: 16px;
    stroke: #ffffff;
  }

  /* Placeholder cuando no hay imagen */
  .featured-card-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 48px;
    font-weight: 700;
  }

  /* Responsive */
  @media (max-width: 992px) {
    .featured-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 16px;
      min-height: 0;
    }

    .featured-card.large,
    .featured-card.small-top,
    .featured-card.small-bottom {
      grid-row: auto;
      grid-column: 1;
      min-height: 240px;
    }

    .featured-card {
      padding: 30px;
    }

    .featured-card-title {
      font-size: 24px;
    }
  }

  @media (max-width: 768px) {
    .featured-grid-section {
      padding: 48px 0;
    }

    .featured-grid-container {
      padding: 0 16px;
    }

    .featured-card {
      padding: 20px;
      min-height: 200px;
    }

    .featured-card-title {
      font-size: 20px;
    }

    .featured-card-subtitle {
      font-size: 14px;
    }
  }
</style>

<div class="featured-grid-section">
  <div class="featured-grid-container">
    <div class="featured-grid">
      
      {% comment %} Tarjeta 1 - Grande Izquierda {% endcomment %}
      {% assign block1 = section.blocks[0] %}
      {% assign collection1 = collections[block1.settings.collection] %}
      {% assign image1 = block1.settings.image | default: collection1.image %}
      {% assign title1 = block1.settings.title | default: collection1.title | default: 'Telas de Señora' %}
      {% assign link1 = block1.settings.link | default: collection1.url | default: '#' %}
      
      <a href="{{ link1 }}" class="featured-card large">
        {% if image1 != blank %}
          <img src="{{ image1 | image_url: width: 800 }}" alt="{{ title1 | escape }}" class="featured-card-bg" loading="lazy">
        {% else %}
          <div class="featured-card-placeholder">1</div>
        {% endif %}
        <div class="featured-card-overlay"></div>
        <div class="featured-card-content">
          <h3 class="featured-card-title">{{ title1 }}</h3>
          <p class="featured-card-subtitle">{{ block1.settings.subtitle | default: 'Lorem ipsum dolor sit amet consectetur.' }}</p>
          <span class="featured-card-button">{{ block1.settings.button_text | default: 'Ver Productos' }} <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></span>
        </div>
      </a>

      {% comment %} Tarjeta 2 - Pequeña Superior Derecha {% endcomment %}
      {% assign block2 = section.blocks[1] %}
      {% assign collection2 = collections[block2.settings.collection] %}
      {% assign image2 = block2.settings.image | default: collection2.image %}
      {% assign title2 = block2.settings.title | default: collection2.title | default: 'Telas de Señora' %}
      {% assign link2 = block2.settings.link | default: collection2.url | default: '#' %}
      
      <a href="{{ link2 }}" class="featured-card small-top">
        {% if image2 != blank %}
          <img src="{{ image2 | image_url: width: 600 }}" alt="{{ title2 | escape }}" class="featured-card-bg" loading="lazy">
        {% else %}
          <div class="featured-card-placeholder">2</div>
        {% endif %}
        <div class="featured-card-overlay"></div>
        <div class="featured-card-content">
          <h3 class="featured-card-title">{{ title2 }}</h3>
          <p class="featured-card-subtitle">{{ block2.settings.subtitle | default: 'Lorem ipsum dolor sit amet consectetur.' }}</p>
          <span class="featured-card-button">{{ block2.settings.button_text | default: 'Ver Productos' }} <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></span>
        </div>
      </a>

      {% comment %} Tarjeta 3 - Pequeña Inferior Derecha {% endcomment %}
      {% assign block3 = section.blocks[2] %}
      {% assign collection3 = collections[block3.settings.collection] %}
      {% assign image3 = block3.settings.image | default: collection3.image %}
      {% assign title3 = block3.settings.title | default: collection3.title | default: 'Telas de Señora' %}
      {% assign link3 = block3.settings.link | default: collection3.url | default: '#' %}
      
      <a href="{{ link3 }}" class="featured-card small-bottom">
        {% if image3 != blank %}
          <img src="{{ image3 | image_url: width: 600 }}" alt="{{ title3 | escape }}" class="featured-card-bg" loading="lazy">
        {% else %}
          <div class="featured-card-placeholder">3</div>
        {% endif %}
        <div class="featured-card-overlay"></div>
        <div class="featured-card-content">
          <h3 class="featured-card-title">{{ title3 }}</h3>
          <p class="featured-card-subtitle">{{ block3.settings.subtitle | default: 'Lorem ipsum dolor sit amet consectetur.' }}</p>
          <span class="featured-card-button">{{ block3.settings.button_text | default: 'Ver Productos' }} <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></span>
        </div>
      </a>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Grid Destacado",
  "tag": "section",
  "class": "section-featured-grid",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo de la sección",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Tarjeta",
      "limit": 3,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección",
          "info": "Selecciona una colección para cargar datos automáticamente"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen personalizada",
          "info": "Opcional. Si no subes imagen, se usa la de la colección"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Telas de Señora",
          "info": "Deja vacío para usar el nombre de la colección"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtítulo",
          "default": "Lorem ipsum dolor sit amet consectetur."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Texto del botón",
          "default": "Ver Productos"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace personalizado",
          "info": "Opcional. Si no pones nada, usa el enlace de la colección"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid Destacado",
      "category": "Grid"
    }
  ]
}
{% endschema %}
