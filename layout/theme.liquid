<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %} Google Fonts - Lato {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@100;300;400;700;900&display=swap" rel="stylesheet">

    {% comment %} CRITICAL CSS - Lato Font Force {% endcomment %}
    <style>
      /* Forzar fuente Lato en TODO el sitio */
      *,
      *::before,
      *::after,
      html,
      body,
      h1, h2, h3, h4, h5, h6,
      .h1, .h2, .h3, .h4, .h5, .h6,
      p, span, div,
      a, button,
      input, textarea, select,
      label, legend,
      li, ul, ol,
      table, th, td,
      figcaption,
      blockquote,
      strong, b, em, i,
      small, .small,
      .title, .subtitle,
      .heading, .subheading,
      .nav-link, .menu-link,
      .btn, .button,
      .card-title, .product-title,
      .price, .compare-price,
      .cart-count,
      .article-title,
      .search-input,
      [class*="title"],
      [class*="text"],
      [class*="heading"],
      [class*="label"] {
        font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif !important;
      }
      
      /* Variables para uso en componentes */
      :root {
        --font-heading-family: 'Lato', sans-serif !important;
        --font-body-family: 'Lato', sans-serif !important;
        --font-button-family: 'Lato', sans-serif !important;
      }
    </style>

    {% comment %} Custom Fonts Injection {% endcomment %}
    {% if settings.custom_font_heading_url != blank or settings.custom_font_body_url != blank %}
      <style>
        {% if settings.custom_font_heading_url != blank %}
          @font-face {
            font-family: '{{ settings.custom_font_heading_name }}';
            src: url('{{ settings.custom_font_heading_url }}') format('{% if settings.custom_font_heading_url contains ".woff2" %}woff2{% else %}woff{% endif %}');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
          }
          :root {
            --font-heading-family: '{{ settings.custom_font_heading_name }}', sans-serif;
          }
          h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
            font-family: '{{ settings.custom_font_heading_name }}', sans-serif !important;
          }
        {% endif %}

        {% if settings.custom_font_body_url != blank %}
          @font-face {
            font-family: '{{ settings.custom_font_body_name }}';
            src: url('{{ settings.custom_font_body_url }}') format('{% if settings.custom_font_body_url contains ".woff2" %}woff2{% else %}woff{% endif %}');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
          }
          :root {
            --font-body-family: '{{ settings.custom_font_body_name }}', sans-serif;
          }
          body, p, li, a, .body {
            font-family: '{{ settings.custom_font_body_name }}', sans-serif !important;
          }
        {% endif %}
      </style>
    {% endif %}

    {% comment %} Global Typography Styles con Lato {% endcomment %}
    <style>
      /* FORZAR LATO EN TODOS LOS ELEMENTOS */
      *, *::before, *::after {
        font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      }
      
      :root {
        --font-heading-family: 'Lato', sans-serif !important;
        --font-body-family: 'Lato', sans-serif !important;
        
        --main-title-size: {{ settings.main_title_size }}px;
        --main-title-weight: {{ settings.main_title_weight }};
        --main-title-spacing: {{ settings.main_title_spacing }}px;
        --main-title-height: {{ settings.main_title_height }};

        --secondary-title-size: {{ settings.secondary_title_size }}px;
        --secondary-title-weight: {{ settings.secondary_title_weight }};
        --secondary-title-spacing: {{ settings.secondary_title_spacing }}px;
        --secondary-title-height: {{ settings.secondary_title_height }};

        --small-title-size: {{ settings.small_title_size }}px;
        --small-title-weight: {{ settings.small_title_weight }};
        --small-title-spacing: {{ settings.small_title_spacing }}px;
        --small-title-height: {{ settings.small_title_height }};

        --paragraph-size: {{ settings.paragraph_size }}px;
        --paragraph-weight: {{ settings.paragraph_weight }};
        --paragraph-spacing: {{ settings.paragraph_spacing }}px;
        --paragraph-height: {{ settings.paragraph_height }};
        
        --button-size: {{ settings.button_size }}px;
        --button-weight: {{ settings.button_weight }};
        --button-spacing: {{ settings.button_spacing }}px;
        --button-transform: {{ settings.button_transform }};

        /* Default colors fallback */
        --main-title-color: var(--color-foreground);
        --secondary-title-color: var(--color-foreground);
        --small-title-color: var(--color-foreground);
        --paragraph-color: var(--color-foreground);
        --small-paragraph-color: var(--color-foreground);
        --emphasis-color: var(--color-foreground);
      }

      h1, .h1 { 
        font-family: 'Lato', sans-serif !important;
        font-size: var(--main-title-size); 
        font-weight: var(--main-title-weight); 
        letter-spacing: var(--main-title-spacing); 
        line-height: var(--main-title-height); 
        color: var(--main-title-color); 
      }
      h2, .h2 { 
        font-family: 'Lato', sans-serif !important;
        font-size: var(--secondary-title-size); 
        font-weight: var(--secondary-title-weight); 
        letter-spacing: var(--secondary-title-spacing); 
        line-height: var(--secondary-title-height); 
        color: var(--secondary-title-color); 
      }
      h3, .h3, h4, .h4 { 
        font-family: 'Lato', sans-serif !important;
        font-size: var(--small-title-size); 
        font-weight: var(--small-title-weight); 
        letter-spacing: var(--small-title-spacing); 
        line-height: var(--small-title-height); 
        color: var(--small-title-color); 
      }
      
      body, p, .body { 
        font-family: 'Lato', sans-serif !important;
        font-size: var(--paragraph-size); 
        font-weight: 400;
        letter-spacing: var(--paragraph_spacing); 
        line-height: var(--paragraph-height); 
        color: var(--paragraph-color);
      }
      
      /* Párrafos de encabezados de secciones con más grosor */
      .carousel-subtitle,
      .hero-subtitle,
      .plp-description,
      .contact-subtitle,
      .blog-subtitle,
      .article-excerpt,
      .search-count,
      .section-subtitle,
      [class*="subtitle"],
      [class*="-subtitle"],
      [class*="description"],
      [class*="-desc"],
      .rte p,
      .content p {
        font-family: 'Lato', sans-serif !important;
        font-weight: 500 !important;
      }

      button, .btn, .button { 
        font-family: 'Lato', sans-serif !important;
        font-size: var(--button-size); 
        font-weight: var(--button-weight); 
        letter-spacing: var(--button-spacing); 
        text-transform: var(--button-transform); 
      }
      small, .small, .caption { 
        font-family: 'Lato', sans-serif !important;
        font-size: {{ settings.small_paragraph_size }}px; 
        font-weight: {{ settings.small_paragraph_weight }}; 
        color: var(--small-paragraph-color); 
      }
      .emphasis { 
        font-family: 'Lato', sans-serif !important;
        font-size: {{ settings.emphasis_size }}px; 
        font-weight: {{ settings.emphasis_weight }}; 
        color: var(--emphasis-color); 
      }

      /* Button Presets */
      {% for i in (1..3) %}
        {% capture border_width_key %}btn{{ i }}_border_width{% endcapture %}
        {% capture border_pos_key %}btn{{ i }}_border_position{% endcapture %}
        {% capture radius_key %}btn{{ i }}_radius{% endcapture %}
        {% capture pad_v_key %}btn{{ i }}_padding_v{% endcapture %}
        {% capture pad_h_key %}btn{{ i }}_padding_h{% endcapture %}

        .btn-preset-{{ i }} {
          padding: {{ settings[pad_v_key] }}px {{ settings[pad_h_key] }}px;
          border-radius: {{ settings[radius_key] }}px;
          {% if settings[border_pos_key] == 'all' %}
            border: {{ settings[border_width_key] }}px solid var(--color-button-border);
          {% else %}
            border: 0;
            border-{{ settings[border_pos_key] }}: {{ settings[border_width_key] }}px solid var(--color-button-border);
          {% endif %}
          transition: opacity 0.2s;
          text-decoration: none;
          display: inline-block;
        }
        .btn-preset-{{ i }}:hover { opacity: 0.9; }
      {% endfor %}

      .btn-preset-1 {
        background-color: var(--color-button);
        color: var(--color-button-text);
      }
      .btn-preset-2 {
        background-color: transparent;
        color: var(--color-secondary-button-text);
      }
       .btn-preset-3 {
        background-color: transparent;
        color: var(--color-secondary-button-text);
      }

      /* Color Schemes Generation */
      {% for scheme in settings.color_schemes %}
        .color-{{ scheme.id }}, .gradient.color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background }};
          --gradient-background: {{ scheme.settings.background }};
          --color-foreground: {{ scheme.settings.text }};
          
          /* Scheme colors */
          --color-button: {{ scheme.settings.button_background }};
          --color-button-text: {{ scheme.settings.button_label }};
          --color-button-border: {{ scheme.settings.secondary_button_label }};
          --color-secondary-button-text: {{ scheme.settings.secondary_button_label }};
          --color-shadow: {{ scheme.settings.shadow }};

          /* Override global typography colors locally */
          --main-title-color: {{ scheme.settings.title_color | default: scheme.settings.text }};
          --secondary-title-color: {{ scheme.settings.subtitle_color | default: scheme.settings.text }};
          --small-title-color: {{ scheme.settings.subtitle_color | default: scheme.settings.text }};
          --paragraph-color: {{ scheme.settings.text }};
          --small-paragraph-color: {{ scheme.settings.text }};
          --emphasis-color: {{ scheme.settings.text }};
          
          /* Aplicar colores a elementos */
          color: var(--color-foreground);
          background: var(--gradient-background);
        }
      {% endfor %}
    </style>

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'fonts.css.liquid' | asset_url | stylesheet_tag: preload: true }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% comment %} Evita scroll horizontal si algún hijo se desborda ligeramente {% endcomment %}
    <style>
      html {
        overflow-x: clip;
      }
      @supports not (overflow: clip) {
        html {
          overflow-x: hidden;
        }
      }
    </style>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    {{ 'snc-sections.js' | asset_url | script_tag }}
  </body>
</html>
